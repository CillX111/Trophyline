<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Trophyline.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- palette (always dark, Steam-like) -->
        <SolidColorBrush x:Key="Bg" Color="#0B1016"/>
        <SolidColorBrush x:Key="Panel" Color="#0F151C"/>
        <SolidColorBrush x:Key="Card" Color="#151C25"/>
        <SolidColorBrush x:Key="CardHi" Color="#1C2633"/>
        <SolidColorBrush x:Key="Line" Color="#243042"/>
        <SolidColorBrush x:Key="Text" Color="#E9EEF4"/>
        <SolidColorBrush x:Key="Muted" Color="#8B99AB"/>
        <!-- accent defaults; Theme.Apply replaces these with the colour picked in Settings -->
        <SolidColorBrush x:Key="Accent" Color="#66C0F4"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#1A3247"/>
        <SolidColorBrush x:Key="AccentHover" Color="#8CD0F7"/>
        <SolidColorBrush x:Key="AccentGradient" Color="#66C0F4"/>
        <SolidColorBrush x:Key="AccentAvatar" Color="#66C0F4"/>
        <SolidColorBrush x:Key="AccentHead" Color="#1A3247"/>
        <SolidColorBrush x:Key="AccentNav" Color="#1A3247"/>
        <SolidColorBrush x:Key="AccentWash" Color="Transparent"/>
        <SolidColorBrush x:Key="Gold" Color="#F5C451"/>
        <SolidColorBrush x:Key="Green" Color="#5BD68A"/>
        <SolidColorBrush x:Key="Purple" Color="#B98CFF"/>

