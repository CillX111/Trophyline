<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Trophyline.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- palette (always dark, Steam-like) -->
        <SolidColorBrush x:Key="Bg" Color="#0B1016"/>
        <SolidColorBrush x:Key="Panel" Color="#0F151C"/>
        <SolidColorBrush x:Key="Card" Color="#151C25"/>
        <SolidColorBrush x:Key="CardHi" Color="#1C2633"/>
        <SolidColorBrush x:Key="Line" Color="#243042"/>
        <SolidColorBrush x:Key="Text" Color="#E9EEF4"/>
        <SolidColorBrush x:Key="Muted" Color="#8B99AB"/>
        <SolidColorBrush x:Key="Accent" Color="#66C0F4"/>
        <SolidColorBrush x:Key="Gold" Color="#F5C451"/>
        <SolidColorBrush x:Key="Green" Color="#5BD68A"/>
        <SolidColorBrush x:Key="Purple" Color="#B98CFF"/>

        <!-- icons (24x24 paths, so they look the same on every system) -->
        <StreamGeometry x:Key="IconHome">M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</StreamGeometry>
        <StreamGeometry x:Key="IconStar">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</StreamGeometry>
        <StreamGeometry x:Key="IconGame">M7,6H17A6,6 0 0,1 23,12A6,6 0 0,1 17,18C15.22,18 13.63,17.23 12.53,16H11.47C10.37,17.23 8.78,18 7,18A6,6 0 0,1 1,12A6,6 0 0,1 7,6M6,9V11H4V13H6V15H8V13H10V11H8V9H6M15.5,12A1.5,1.5 0 0,0 14,13.5A1.5,1.5 0 0,0 15.5,15A1.5,1.5 0 0,0 17,13.5A1.5,1.5 0 0,0 15.5,12M18.5,9A1.5,1.5 0 0,0 17,10.5A1.5,1.5 0 0,0 18.5,12A1.5,1.5 0 0,0 20,10.5A1.5,1.5 0 0,0 18.5,9Z</StreamGeometry>
        <StreamGeometry x:Key="IconDrive">M5,4H19L22,12V19A1,1 0 0,1 21,20H3A1,1 0 0,1 2,19V12L5,4M4.5,13V18H19.5V13H4.5M16,14.5A1,1 0 0,1 17,15.5A1,1 0 0,1 16,16.5A1,1 0 0,1 15,15.5A1,1 0 0,1 16,14.5M6.4,6L4.3,11H19.7L17.6,6H6.4Z</StreamGeometry>
        <StreamGeometry x:Key="IconClock">M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconBolt">M7,2V13H10V22L17,10H13L17,2H7Z</StreamGeometry>
        <StreamGeometry x:Key="IconChart">M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z</StreamGeometry>
        <StreamGeometry x:Key="IconBack">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://Trophyline/Styles.axaml"/>
    </Application.Styles>
</Application>
