<Window x:Class="Trophyline.JournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trophyline" Width="1280" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- ===== palette (always dark, Steam-like) ===== -->
        <SolidColorBrush x:Key="Bg" Color="#0B1016"/>
        <SolidColorBrush x:Key="Panel" Color="#0F151C"/>
        <SolidColorBrush x:Key="Card" Color="#151C25"/>
        <SolidColorBrush x:Key="CardHi" Color="#1C2633"/>
        <SolidColorBrush x:Key="Line" Color="#243042"/>
        <SolidColorBrush x:Key="Text" Color="#E9EEF4"/>
        <SolidColorBrush x:Key="Muted" Color="#8B99AB"/>
        <SolidColorBrush x:Key="Accent" Color="#66C0F4"/>
        <SolidColorBrush x:Key="Gold" Color="#F5C451"/>
        <SolidColorBrush x:Key="Green" Color="#5BD68A"/>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- thin dark scroll bars -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#33475E" CornerRadius="4" Margin="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#33475E" CornerRadius="4" Margin="2"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- search box with placeholder (Tag = placeholder text) -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="38,9,12,9"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Grid>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Muted}"
                                           VerticalAlignment="Center" Margin="13,0,0,0" FontSize="14"/>
                                <Grid Margin="{TemplateBinding Padding}">
                                    <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Muted}"
                                               IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- themed drop-down -->
        <Style x:Key="Dropdown" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MaxDropDownHeight" Value="420"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Padding="12,7" Background="Transparent" CornerRadius="6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Line}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                                                BorderThickness="1" CornerRadius="10">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                                  Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.6"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              TextElement.Foreground="{DynamicResource Text}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardHi}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        CornerRadius="10" Padding="4" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- sidebar navigation (Tag = icon glyph) -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="14,11">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource Accent}"
                                        HorizontalAlignment="Left" Margin="-14,0,0,0" Visibility="Hidden"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Ico" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141C26"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18222E"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- filter chips -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="16" Padding="14,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A3247"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- plain clickable wrapper -->
        <Style x:Key="Clickable" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#AA0B1016" CornerRadius="18" Padding="14,7" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- rarity pill used in several templates -->
        <DataTemplate x:Key="RarityPill">
            <Border CornerRadius="10" Padding="8,2" Background="{Binding PillBackground}" Visibility="{Binding PillVisibility}"
                    VerticalAlignment="Center" ToolTip="{Binding RarityTip}">
                <TextBlock Text="{Binding PillText}" Foreground="{Binding PillBrush}" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>

        <!-- big achievement row -->
        <DataTemplate x:Key="AchRow">
            <Border Style="{StaticResource CardStyle}" CornerRadius="12" Padding="12" Margin="0,0,0,8" Opacity="{Binding RowOpacity}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="9" Background="{DynamicResource Line}"
                            BorderBrush="{Binding IconBorder}" BorderThickness="2">
                        <Border CornerRadius="7">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap"
                                   Margin="0,2,0,0" Visibility="{Binding DescriptionVisibility}"/>
                        <TextBlock Text="{Binding Game}" Foreground="{DynamicResource Accent}" FontSize="13" Margin="0,3,0,0"
                                   Visibility="{Binding GameVisibility}"/>
                    </StackPanel>
                    <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource RarityPill}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding When}" Foreground="{DynamicResource Muted}" FontSize="13"
                               VerticalAlignment="Center" MinWidth="120" TextAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- small achievement row (overview lists) -->
        <DataTemplate x:Key="AchCompact">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="7" Background="{DynamicResource Line}"
                        BorderBrush="{Binding IconBorder}" BorderThickness="2">
                    <Border CornerRadius="5">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Game, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding WhenShort, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource RarityPill}"/>
            </Grid>
        </DataTemplate>

        <!-- game card -->
        <DataTemplate x:Key="GameCard">
            <Button Style="{StaticResource Clickable}" Click="OpenGame_Click" Margin="0,0,16,18" Width="170"
                    ToolTip="{Binding Name}">
                <StackPanel>
                    <Grid Height="255">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><TranslateTransform/></Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value><TranslateTransform Y="-5"/></Setter.Value>
                                        </Setter>
                                        <Setter Property="Effect">
                                            <Setter.Value><DropShadowEffect Color="#66C0F4" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border CornerRadius="11" Background="{DynamicResource CardHi}"/>
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                   Margin="14" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                        <Border CornerRadius="11">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="0,0,11,11" VerticalAlignment="Bottom" Height="70" Visibility="{Binding AchVisibility}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#000B1016" Offset="0"/>
                                    <GradientStop Color="#EE0B1016" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid VerticalAlignment="Bottom" Margin="10,0,10,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding ProgressBrush}"/>
                                    <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="#CFD8E3"/>
                                </DockPanel>
                                <Grid Grid.Row="1" Height="5">
                                    <Border CornerRadius="3" Background="#40FFFFFF"/>
                                    <Border CornerRadius="3" Background="{Binding ProgressBrush}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Completion}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border CornerRadius="11" BorderThickness="2" BorderBrush="{Binding CardBorder}"/>
                        <Border Visibility="{Binding PerfectVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Background="{DynamicResource Gold}" CornerRadius="9" Padding="7,2">
                            <TextBlock Text="★ 100%" Foreground="#1A1300" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Margin="2,10,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CardSub}" Margin="2,2,0,0" Foreground="{DynamicResource Muted}" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="FlatList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="ItemTemplate" Value="{StaticResource AchRow}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <GroupStyle x:Key="MonthGroups">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Margin="2,16,0,10" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource Muted}" Typography.Capitals="AllSmallCaps"/>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= sidebar ================= -->
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,26,0,26">
                    <Image Source="pack://application:,,,/assets/logo.png" Width="40" Height="40"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Trophyline" FontWeight="Bold" FontSize="18" LineHeight="20"/>
                        <TextBlock Text="STEAM ACHIEVEMENTS" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- profile -->
                <Border DockPanel.Dock="Bottom" Margin="14" Padding="12" CornerRadius="12" Background="#121A23">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="40" Height="40">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#66C0F4" Offset="0"/>
                                        <GradientStop Color="#7B5CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="AvatarLetter" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="17" Foreground="White"/>
                        </Grid>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ProfileName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="TrackerDot" Width="7" Height="7" Fill="{DynamicResource Green}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TrackerText" Text="Tracking" FontSize="12" Foreground="{DynamicResource Muted}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Overview" IsChecked="True"/>
                    <RadioButton x:Name="NavAchievements" Style="{StaticResource NavButton}" Tag="&#xE734;" Content="Achievements"/>
                    <RadioButton x:Name="NavGames" Style="{StaticResource NavButton}" Tag="&#xE7FC;" Content="Games"/>
                    <RadioButton x:Name="NavStorage" Style="{StaticResource NavButton}" Tag="&#xEDA2;" Content="Storage"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= pages ================= -->
        <Grid Grid.Column="1" x:Name="Pages">

            <!-- Overview -->
            <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,26,30,30">
                    <Border x:Name="HeroCard" Height="290" CornerRadius="18" Background="{DynamicResource Card}">
                        <Grid>
                            <Border CornerRadius="18">
                                <Border.Background>
                                    <ImageBrush x:Name="HeroImage" Stretch="UniformToFill" AlignmentY="Top"/>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F00B1016" Offset="0"/>
                                        <GradientStop Color="#990B1016" Offset="0.45"/>
                                        <GradientStop Color="#100B1016" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#000B1016" Offset="0.5"/>
                                        <GradientStop Color="#CC0B1016" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Bottom" Margin="32,0,0,30">
                                <TextBlock Text="WELCOME BACK" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock x:Name="Persona" FontSize="44" FontWeight="Bold" Margin="0,2,0,0"/>
                                <TextBlock x:Name="HeroSub" Foreground="#C5D0DC" FontSize="15" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Image x:Name="HeroLogo" MaxHeight="120" MaxWidth="340" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,32,28" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.7"/>
                                </Image.Effect>
                            </Image>
                        </Grid>
                    </Border>

                    <UniformGrid x:Name="Tiles" Columns="3" Margin="-8,18,-8,0"/>

                    <Border Style="{StaticResource CardStyle}" Padding="22,18" Margin="0,18,0,0">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" x:Name="HeatLegend"/>
                                <StackPanel>
                                    <TextBlock Text="Achievement activity" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="ActivitySub" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,16,0,0">
                                <Canvas x:Name="Heatmap"/>
                            </Viewbox>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Padding="20,18,20,8">
                            <StackPanel>
                                <TextBlock Text="Recent unlocks" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource AchCompact}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20,18,20,8">
                            <StackPanel>
                                <TextBlock Text="Rarest unlocks" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                <ItemsControl x:Name="RareList" ItemTemplate="{StaticResource AchCompact}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DockPanel Margin="0,26,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Clickable}" Click="ShowAllGames_Click" VerticalAlignment="Bottom">
                            <TextBlock Text="See all games  →" Foreground="{DynamicResource Accent}"/>
                        </Button>
                        <TextBlock Text="Most played" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <ItemsControl x:Name="MostPlayed" ItemTemplate="{StaticResource GameCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Achievements -->
            <Grid x:Name="AchievementsPage" Margin="30,26,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Achievements" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="AchSub" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,18,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AchSearch" Style="{StaticResource SearchBox}" Tag="Search achievements or games…"/>
                    <ComboBox x:Name="AchGame" Grid.Column="2" Style="{StaticResource Dropdown}"/>
                    <ComboBox x:Name="AchRarity" Grid.Column="4" Style="{StaticResource Dropdown}"/>
                </Grid>
                <ListBox x:Name="AchList" Grid.Row="2" Style="{StaticResource FlatList}"/>
                <TextBlock x:Name="AchEmpty" Grid.Row="2" Margin="0,40,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource Muted}" Visibility="Collapsed" TextWrapping="Wrap"/>
            </Grid>

            <!-- Games -->
            <Grid x:Name="GamesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="30,26,30,0">
                    <TextBlock Text="Games" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="GamesSub" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                    <Grid Margin="0,18,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GameSearch" Style="{StaticResource SearchBox}" Tag="Search games…"/>
                        <ComboBox x:Name="GameSort" Grid.Column="2" Style="{StaticResource Dropdown}"/>
                    </Grid>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GamesGrid" ItemTemplate="{StaticResource GameCard}" Margin="30,4,14,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- One game -->
            <Grid x:Name="GamePage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Height="270">
                    <Border>
                        <Border.Background>
                            <ImageBrush x:Name="GameHero" Stretch="UniformToFill" AlignmentY="Top"/>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#330B1016" Offset="0"/>
                                <GradientStop Color="#660B1016" Offset="0.5"/>
                                <GradientStop Color="#FF0B1016" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Button Style="{StaticResource PillButton}" Click="Back_Click" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="26,22,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Back"/>
                        </StackPanel>
                    </Button>
                    <Grid VerticalAlignment="Bottom" Margin="30,0,30,14">
                        <Image x:Name="GameLogo" MaxHeight="120" MaxWidth="420" HorizontalAlignment="Left"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.8"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock x:Name="GameTitle" FontSize="38" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Grid>
                </Grid>
                <StackPanel Grid.Row="1" Margin="30,4,30,0">
                    <WrapPanel x:Name="GameStats"/>
                    <Grid Margin="0,14,0,0" Height="8" x:Name="GameBarHost">
                        <Border CornerRadius="4" Background="{DynamicResource Line}"/>
                        <Border x:Name="GameBar" CornerRadius="4" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="GameBarScale" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,4" x:Name="GameChips">
                        <RadioButton x:Name="ChipAll" Style="{StaticResource Chip}" GroupName="GameFilter" Content="All" IsChecked="True"/>
                        <RadioButton x:Name="ChipUnlocked" Style="{StaticResource Chip}" GroupName="GameFilter" Content="Unlocked"/>
                        <RadioButton x:Name="ChipLocked" Style="{StaticResource Chip}" GroupName="GameFilter" Content="Still to get"/>
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="GameAchList" Grid.Row="2" Style="{StaticResource FlatList}" Margin="30,0,30,0"/>
                <TextBlock x:Name="GameNoAch" Grid.Row="2" Margin="30,30,30,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                           Visibility="Collapsed" Text="This game has no Steam achievements."/>
            </Grid>

            <!-- Storage -->
            <Grid x:Name="StoragePage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="30,26,30,18">
                    <TextBlock Text="Storage" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="StorageSub" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StorageList" Margin="30,0,30,24">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Btn" Style="{StaticResource Clickable}" Click="OpenGame_Click" Margin="0,0,0,10">
                                    <Border x:Name="Row" Style="{StaticResource CardStyle}" CornerRadius="12" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="150" Height="70" CornerRadius="8" Background="{DynamicResource CardHi}">
                                                <Border CornerRadius="8">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding HeaderImage}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,0,20,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                                    <Border Visibility="{Binding StaleVisibility}" Margin="10,0,0,0" CornerRadius="9" Padding="8,1"
                                                            Background="#33F59E4B" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StaleText}" Foreground="#F5B36B" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StorageSub}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,3,0,8"/>
                                                <Grid Height="6">
                                                    <Border CornerRadius="3" Background="{DynamicResource Line}"/>
                                                    <Border CornerRadius="3" RenderTransformOrigin="0,0.5">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#66C0F4" Offset="0"/>
                                                                <GradientStop Color="#7B5CFF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding SizeFraction}"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="20" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" MinWidth="90" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Btn" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- loading / problem overlay -->
            <Border x:Name="Overlay" Background="{DynamicResource Bg}" Visibility="Collapsed">
                <TextBlock x:Name="OverlayText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource Muted}" FontSize="15" TextWrapping="Wrap" MaxWidth="560"/>
            </Border>
        </Grid>
    </Grid>
</Window>
