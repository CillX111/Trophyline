<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Trophyline"
        x:Class="Trophyline.MainWindow"
        Title="Trophyline" Icon="/assets/logo.png"
        Width="1280" Height="860" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontSize="14">

    <Window.Resources>
        <!-- small achievement row (overview lists) -->
        <DataTemplate x:Key="AchCompact" DataType="local:AchVM">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                <Border Width="42" Height="42" CornerRadius="7" Background="{StaticResource Line}"
                        BorderBrush="{Binding IconBorder}" BorderThickness="2" ClipToBounds="True">
                    <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding GameAndWhen}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Background="{Binding PillBackground}"
                        IsVisible="{Binding HasRarity}" VerticalAlignment="Center" ToolTip.Tip="{Binding RarityTip}">
                    <TextBlock Text="{Binding PillText}" Foreground="{Binding PillBrush}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- game card -->
        <DataTemplate x:Key="GameCard" DataType="local:GameVM">
            <Button Classes="plain" Click="OpenGame_Click" Margin="0,0,16,18" Width="170" ToolTip.Tip="{Binding Name}">
                <StackPanel>
                    <Panel Classes="art" Height="255">
                        <Border Classes="artFrame" CornerRadius="11" Background="{StaticResource CardHi}" ClipToBounds="True">
                            <Panel>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                           Margin="14" FontWeight="SemiBold" Classes="muted"/>
                                <Image Source="{Binding Portrait}" Stretch="UniformToFill"/>
                                <Border VerticalAlignment="Bottom" Height="72" IsVisible="{Binding HasAchievements}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                            <GradientStop Color="#000B1016" Offset="0"/>
                                            <GradientStop Color="#EE0B1016" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10" Spacing="5">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{Binding ProgressBrush}"/>
                                            <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="#CFD8E3"/>
                                        </DockPanel>
                                        <ProgressBar Classes="thin" Value="{Binding Completion}" Foreground="{Binding ProgressBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </Border>
                        <Border CornerRadius="11" BorderThickness="2" BorderBrush="{Binding CardBorder}"/>
                        <Border IsVisible="{Binding Perfect}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Background="{StaticResource Gold}" CornerRadius="9" Padding="7,2">
                            <TextBlock Text="★ 100%" Foreground="#1A1300" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Panel>
                    <TextBlock Text="{Binding Name}" Margin="2,10,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CardSub}" Margin="2,2,0,0" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Spotify playlist card -->
        <DataTemplate x:Key="PlaylistCard" DataType="local:PlaylistVM">
            <Button Classes="plain" Click="PlayPlaylist_Click" Margin="0,0,18,20" Width="180" ToolTip.Tip="Play in Spotify">
                <StackPanel>
                    <Panel Classes="art" Width="180" Height="180">
                        <Border Classes="artFrame" CornerRadius="12" Background="{StaticResource CardHi}" ClipToBounds="True">
                            <Panel>
                                <PathIcon Data="{StaticResource IconMusic}" Width="48" Height="48" Foreground="{StaticResource Muted}"/>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                            </Panel>
                        </Border>
                        <Border Classes="playBadge" Width="48" Height="48" CornerRadius="24" Background="{StaticResource SpotifyGreen}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" BoxShadow="0 4 14 0 #80000000">
                            <PathIcon Data="{StaticResource IconPlay}" Width="20" Height="20" Foreground="#0B1016"/>
                        </Border>
                        <Button Classes="icon remove" Click="RemovePlaylist_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="6" Width="28" Height="28" Background="#CC0B1016" ToolTip.Tip="Remove from Trophyline">
                            <Border Background="#CC0B1016" CornerRadius="14" Width="28" Height="28">
                                <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12"/>
                            </Border>
                        </Button>
                    </Panel>
                    <TextBlock Text="{Binding Title}" Margin="2,10,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding KindText}" Margin="2,2,0,0" Classes="muted" FontSize="12"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid ColumnDefinitions="236,*">

        <!-- ================= sidebar ================= -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#121A24" Offset="0"/>
                    <GradientStop Color="#0C1117" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,26,0,26" Spacing="12">
                    <Image Source="/assets/logo.png" Width="40" Height="40"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Trophyline" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="STEAM ACHIEVEMENTS" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- profile -->
                <Button DockPanel.Dock="Bottom" Classes="plain" Click="OpenLevel_Click" Margin="14" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" ToolTip.Tip="Your level: click to see how you earn XP">
                <Border Classes="row" Padding="12" CornerRadius="12" Background="#121A23" BorderThickness="1" BorderBrush="Transparent">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Panel Width="40" Height="40">
                                <Ellipse Fill="{DynamicResource AccentAvatar}"/>
                                <TextBlock x:Name="AvatarLetter" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="Bold" FontSize="17" Foreground="White"/>
                                <Ellipse x:Name="SidePic" IsVisible="False"/>
                                <!-- level badge on the avatar -->
                                <Border x:Name="LevelBadge" MinWidth="22" Height="20" CornerRadius="10" Padding="5,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-5"
                                        Background="{StaticResource Gold}" BorderBrush="#121A23" BorderThickness="2">
                                    <TextBlock x:Name="LevelBadgeText" Text="1" FontSize="10" FontWeight="Bold" Foreground="#0B1016"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Panel>
                            <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock x:Name="ProfileName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="136"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                    <Ellipse x:Name="TrackerDot" Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TrackerText" Text="Tracking live" FontSize="12" Classes="muted"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <DockPanel>
                                <TextBlock x:Name="SideXp" DockPanel.Dock="Right" FontSize="11" Classes="muted" Margin="6,0,0,0" ToolTip.Tip="XP into this level"/>
                                <TextBlock x:Name="SideLevel" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ProgressBar x:Name="SideXpBar" Classes="thin" Background="{StaticResource Line}" Foreground="{DynamicResource Accent}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </Button>

                <!-- Spotify mini-player -->
                <Border DockPanel.Dock="Bottom" Margin="14,0,14,0" Padding="12,12,12,8" CornerRadius="12" Background="#121A23">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource SpotifyGreen}">
                                <PathIcon Data="{StaticResource IconMusic}" Width="17" Height="17" Foreground="#0B1016"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Width="140">
                                <TextBlock x:Name="MiniTitle" Text="Spotify" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MiniArtist" Text="" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="MiniButtons" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button Classes="icon" Click="Prev_Click" ToolTip.Tip="Previous">
                                <PathIcon Data="{StaticResource IconPrev}" Width="15" Height="15"/>
                            </Button>
                            <Button Classes="icon big" Click="PlayPause_Click" ToolTip.Tip="Play / pause">
                                <PathIcon x:Name="MiniPlayIcon" Data="{StaticResource IconPlay}" Width="17" Height="17"/>
                            </Button>
                            <Button Classes="icon" Click="Next_Click" ToolTip.Tip="Next">
                                <PathIcon Data="{StaticResource IconNext}" Width="15" Height="15"/>
                            </Button>
                        </StackPanel>
                        <Button x:Name="MiniOpen" Classes="plain" Click="OpenSpotify_Click" HorizontalAlignment="Center" IsVisible="False" Margin="0,0,0,4">
                            <TextBlock Text="Open Spotify" Foreground="{StaticResource SpotifyGreen}" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- the menu scrolls when the window is too short for all of it -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                <StackPanel Margin="0,0,0,6">
                    <RadioButton x:Name="NavOverview" Classes="nav" GroupName="nav" Tag="{StaticResource IconHome}" Content="Overview" IsChecked="True"/>
                    <RadioButton x:Name="NavAchievements" Classes="nav" GroupName="nav" Tag="{StaticResource IconStar}" Content="Achievements"/>
                    <RadioButton x:Name="NavGames" Classes="nav" GroupName="nav" Tag="{StaticResource IconGame}" Content="Games"/>
                    <RadioButton x:Name="NavLevel" Classes="nav" GroupName="nav" Tag="{StaticResource IconShield}" Content="Level"/>
                    <RadioButton x:Name="NavLeaderboard" Classes="nav" GroupName="nav" Tag="{StaticResource IconPodium}" Content="Leaderboards"/>
                    <RadioButton x:Name="NavChat" Classes="nav" GroupName="nav" Tag="{StaticResource IconChat}" Content="Chat"/>
                    <RadioButton x:Name="NavShop" Classes="nav" GroupName="nav" Tag="{StaticResource IconCart}" Content="Shop"/>
                    <RadioButton x:Name="NavPlaytime" IsVisible="False" Classes="nav" GroupName="nav" Tag="{StaticResource IconClock}" Content="Playtime"/>
                    <RadioButton x:Name="NavStorage" IsVisible="False" Classes="nav" GroupName="nav" Tag="{StaticResource IconDrive}" Content="Storage"/>
                    <RadioButton x:Name="NavMusic" Classes="nav" GroupName="nav" Tag="{StaticResource IconMusic}" Content="Music"/>
                    <RadioButton x:Name="NavSettings" Classes="nav" GroupName="nav" Tag="{StaticResource IconSettings}" Content="Settings"/>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= pages ================= -->
        <Panel Grid.Column="1">
            <!-- soft accent glow behind every page -->
            <Border Background="{DynamicResource AccentWash}" IsHitTestVisible="False"/>

            <!-- Overview -->
            <ScrollViewer x:Name="OverviewPage" Classes="page">
                <StackPanel Margin="30,26,30,30">
                    <Border Height="300" CornerRadius="22" Background="{StaticResource Card}" ClipToBounds="True" BorderBrush="#1FFFFFFF" BorderThickness="1" BoxShadow="0 16 44 0 #66000000">
                        <Panel>
                            <Image x:Name="HeroImage" Stretch="UniformToFill" VerticalAlignment="Top"/>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Color="#F00B1016" Offset="0"/>
                                        <GradientStop Color="#990B1016" Offset="0.45"/>
                                        <GradientStop Color="#100B1016" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Color="#000B1016" Offset="0.5"/>
                                        <GradientStop Color="#CC0B1016" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Bottom" Margin="32,0,0,30">
                                <TextBlock Text="WELCOME BACK" Classes="kicker" FontSize="12"/>
                                <TextBlock x:Name="Persona" FontSize="44" FontWeight="Bold" Margin="0,2,0,0"/>
                                <TextBlock x:Name="HeroSub" Foreground="#C5D0DC" FontSize="15" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Image x:Name="HeroLogo" MaxHeight="120" MaxWidth="340" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,32,28"/>
                            <Border Height="3" VerticalAlignment="Bottom" Background="{DynamicResource AccentGradient}" Opacity="0.9"/>
                        </Panel>
                    </Border>

                    <UniformGrid x:Name="Tiles" Columns="3" Margin="-8,18,-8,0"/>

                    <Border Classes="card" Padding="22,18" Margin="0,18,0,0">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" x:Name="HeatLegend"/>
                                <StackPanel>
                                    <TextBlock Text="Achievement activity" Classes="section"/>
                                    <TextBlock x:Name="ActivitySub" Classes="muted" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,16,0,0">
                                <Canvas x:Name="Heatmap"/>
                            </Viewbox>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,18,*" Margin="0,18,0,0">
                        <Border Classes="card" Padding="20,18,20,8">
                            <StackPanel>
                                <TextBlock Text="Recent unlocks" Classes="section" Margin="0,0,0,14"/>
                                <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource AchCompact}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="card" Padding="20,18,20,8">
                            <StackPanel>
                                <TextBlock Text="Rarest unlocks" Classes="section" Margin="0,0,0,14"/>
                                <ItemsControl x:Name="RareList" ItemTemplate="{StaticResource AchCompact}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DockPanel Margin="0,26,0,14">
                        <Button DockPanel.Dock="Right" Classes="plain" Click="ShowAllGames_Click" VerticalAlignment="Bottom">
                            <TextBlock Text="See all games  →" Foreground="{DynamicResource Accent}"/>
                        </Button>
                        <TextBlock Text="Most played" Classes="section"/>
                    </DockPanel>
                    <ItemsControl x:Name="MostPlayed" ItemTemplate="{StaticResource GameCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Achievements -->
            <Grid x:Name="AchievementsPage" Classes="page" RowDefinitions="Auto,Auto,*" Margin="30,26,30,0" IsVisible="False">
                <Border Classes="pageHead"><Panel>
                    <PathIcon Classes="headMark" Data="{StaticResource IconStar}"/>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="headIcon"><PathIcon Data="{StaticResource IconStar}"/></Border>
                        <StackPanel Grid.Column="1" Classes="headText">
                            <TextBlock Classes="kicker" Text="YOUR TROPHY CASE"/>
                            <TextBlock Text="Achievements" Classes="pageTitle"/>
                            <TextBlock x:Name="AchSub" Classes="muted" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Panel></Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,12,230,12,200" Margin="0,18,0,8">
                    <TextBox x:Name="AchSearch" Classes="search" Watermark="Search achievements or games…">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource IconSearch}" Width="15" Height="15" Margin="12,0,2,0" Foreground="{StaticResource Muted}"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <ComboBox x:Name="AchGame" Grid.Column="2" Classes="drop"/>
                    <ComboBox x:Name="AchRarity" Grid.Column="4" Classes="drop"/>
                </Grid>
                <ListBox x:Name="AchList" Grid.Row="2" Classes="flat">
                    <ListBox.DataTemplates>
                        <DataTemplate DataType="local:HeaderRow">
                            <TextBlock Text="{Binding Title}" Classes="groupHeader"/>
                        </DataTemplate>
                        <DataTemplate DataType="local:AchVM">
                            <Border Classes="card" CornerRadius="12" Padding="12" Margin="0,0,10,8" Opacity="{Binding RowOpacity}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="4" Text="{Binding XpText}" Foreground="{Binding XpBrush}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" MinWidth="70" TextAlignment="Right"
                                               ToolTip.Tip="XP this achievement is worth (rarer achievements give more)"/>
                                    <Border Width="56" Height="56" CornerRadius="9" Background="{StaticResource Line}"
                                            BorderBrush="{Binding IconBorder}" BorderThickness="2" ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                            <PathIcon Data="{StaticResource IconLock}" Width="22" Height="22" Foreground="{StaticResource Muted}"
                                                      IsVisible="{Binding Secret}"/>
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   IsVisible="{Binding HasDescription}"/>
                                        <TextBlock Text="{Binding Game}" Foreground="{DynamicResource Accent}" FontSize="13" Margin="0,3,0,0"
                                                   IsVisible="{Binding ShowGame}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Background="{Binding PillBackground}" Margin="0,0,14,0"
                                            IsVisible="{Binding HasRarity}" VerticalAlignment="Center" ToolTip.Tip="{Binding RarityTip}">
                                        <TextBlock Text="{Binding PillText}" Foreground="{Binding PillBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding When}" Classes="muted" FontSize="13" VerticalAlignment="Center"
                                               MinWidth="120" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
                <TextBlock x:Name="AchEmpty" Grid.Row="2" Margin="0,40,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                           Classes="muted" IsVisible="False" TextWrapping="Wrap"/>
            </Grid>

            <!-- Games -->
            <Grid x:Name="GamesPage" Classes="page" RowDefinitions="Auto,*" IsVisible="False">
                <StackPanel Margin="30,26,30,0">
                    <Border Classes="pageHead"><Panel>
                        <PathIcon Classes="headMark" Data="{StaticResource IconGame}"/>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="headIcon"><PathIcon Data="{StaticResource IconGame}"/></Border>
                            <StackPanel Grid.Column="1" Classes="headText">
                                <TextBlock Classes="kicker" Text="YOUR LIBRARY"/>
                                <TextBlock Text="Games" Classes="pageTitle"/>
                                <TextBlock x:Name="GamesSub" Classes="muted" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Panel></Border>
                    <Grid ColumnDefinitions="*,12,220" Margin="0,18,0,18">
                        <TextBox x:Name="GameSearch" Classes="search" Watermark="Search games…">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{StaticResource IconSearch}" Width="15" Height="15" Margin="12,0,2,0" Foreground="{StaticResource Muted}"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <ComboBox x:Name="GameSort" Grid.Column="2" Classes="drop"/>
                    </Grid>
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="GamesGrid" ItemTemplate="{StaticResource GameCard}" Margin="30,4,14,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- One game -->
            <Grid x:Name="GamePage" Classes="page" RowDefinitions="Auto,Auto,*" IsVisible="False">
                <Panel Height="270" ClipToBounds="True">
                    <Image x:Name="GameHero" Stretch="UniformToFill" VerticalAlignment="Top"/>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#330B1016" Offset="0"/>
                                <GradientStop Color="#660B1016" Offset="0.5"/>
                                <GradientStop Color="#FF0B1016" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Button Classes="pill" Click="Back_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,22,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconBack}" Width="14" Height="14"/>
                            <TextBlock Text="Back"/>
                        </StackPanel>
                    </Button>
                    <Grid VerticalAlignment="Bottom" Margin="30,0,30,14" ColumnDefinitions="*,Auto">
                        <Image x:Name="GameLogo" MaxHeight="120" MaxWidth="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="GameTitle" FontSize="38" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                        <Button x:Name="GamePlay" Grid.Column="1" Classes="primary" Click="PlayGame_Click" VerticalAlignment="Bottom" Margin="20,0,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon x:Name="GamePlayIcon" Data="{StaticResource IconPlay}" Width="18" Height="18"/>
                                <TextBlock x:Name="GamePlayText" Text="Play" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Panel>
                <StackPanel Grid.Row="1" Margin="30,4,30,0">
                    <WrapPanel x:Name="GameStats"/>
                    <ProgressBar x:Name="GameBar" Margin="0,14,0,0" Height="8" MinHeight="8" CornerRadius="4" Minimum="0" Maximum="1"
                                 Background="{StaticResource Line}" Foreground="{DynamicResource Accent}">
                        <ProgressBar.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Value" Duration="0:0:0.7" Easing="CubicEaseOut"/>
                            </Transitions>
                        </ProgressBar.Transitions>
                    </ProgressBar>
                    <Border Classes="card" Padding="14,10" Margin="0,14,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource SpotifyGreen}">
                                <PathIcon Data="{StaticResource IconMusic}" Width="16" Height="16" Foreground="#0B1016"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="Soundtrack" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SoundtrackHint" Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="Pick a playlist and it starts in the background whenever you launch this game."/>
                            </StackPanel>
                            <ComboBox x:Name="GameSoundtrack" Grid.Column="2" Classes="drop" MinWidth="240" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="GameChips" Orientation="Horizontal" Margin="0,18,0,4">
                        <RadioButton x:Name="ChipAll" Classes="chip" GroupName="gameFilter" Content="All" IsChecked="True"/>
                        <RadioButton x:Name="ChipUnlocked" Classes="chip" GroupName="gameFilter" Content="Unlocked"/>
                        <RadioButton x:Name="ChipLocked" Classes="chip" GroupName="gameFilter" Content="Still to get"/>
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="GameAchList" Grid.Row="2" Classes="flat" Margin="30,0,20,0">
                    <ListBox.DataTemplates>
                        <DataTemplate DataType="local:HeaderRow">
                            <TextBlock Text="{Binding Title}" Classes="groupHeader"/>
                        </DataTemplate>
                        <DataTemplate DataType="local:AchVM">
                            <Border Classes="card" CornerRadius="12" Padding="12" Margin="0,0,10,8" Opacity="{Binding RowOpacity}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="4" Text="{Binding XpText}" Foreground="{Binding XpBrush}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" MinWidth="70" TextAlignment="Right"
                                               ToolTip.Tip="XP this achievement is worth (rarer achievements give more)"/>
                                    <Border Width="56" Height="56" CornerRadius="9" Background="{StaticResource Line}"
                                            BorderBrush="{Binding IconBorder}" BorderThickness="2" ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                            <PathIcon Data="{StaticResource IconLock}" Width="22" Height="22" Foreground="{StaticResource Muted}"
                                                      IsVisible="{Binding Secret}"/>
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   IsVisible="{Binding HasDescription}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Background="{Binding PillBackground}" Margin="0,0,14,0"
                                            IsVisible="{Binding HasRarity}" VerticalAlignment="Center" ToolTip.Tip="{Binding RarityTip}">
                                        <TextBlock Text="{Binding PillText}" Foreground="{Binding PillBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding When}" Classes="muted" FontSize="13" VerticalAlignment="Center"
                                               MinWidth="120" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
                <TextBlock x:Name="GameNoAch" Grid.Row="2" Margin="30,30,30,0" Classes="muted" TextWrapping="Wrap"
                           IsVisible="False" Text="This game has no Steam achievements."/>
            </Grid>

            <!-- Storage -->
            <Grid x:Name="StoragePage" Classes="page" RowDefinitions="Auto,*" IsVisible="False">
                <StackPanel Margin="30,26,30,18"><Border Classes="pageHead"><Panel>
                    <PathIcon Classes="headMark" Data="{StaticResource IconDrive}"/>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="headIcon"><PathIcon Data="{StaticResource IconDrive}"/></Border>
                        <StackPanel Grid.Column="1" Classes="headText">
                            <TextBlock Classes="kicker" Text="DISK SPACE"/>
                            <TextBlock Text="Storage" Classes="pageTitle"/>
                            <TextBlock x:Name="StorageSub" Classes="muted" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Panel></Border></StackPanel>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="StorageList" Margin="30,0,30,24">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="local:GameVM">
                                <Button Classes="plain" Click="OpenGame_Click" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Border Classes="card row" CornerRadius="12" Padding="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="150" Height="70" CornerRadius="8" Background="{StaticResource CardHi}" ClipToBounds="True">
                                                <Image Source="{Binding HeaderImage}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,0,20,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                                    <Border IsVisible="{Binding Stale}" CornerRadius="9" Padding="8,1" Background="#33F59E4B" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StaleText}" Foreground="#F5B36B" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StorageSub}" Classes="muted" FontSize="13" Margin="0,3,0,8"/>
                                                <ProgressBar Classes="thin" Height="6" MinHeight="6" Value="{Binding SizeFraction}" Background="{StaticResource Line}"
                                                             Foreground="{DynamicResource AccentGradient}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="20" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" MinWidth="90" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Music -->
            <ScrollViewer x:Name="MusicPage" Classes="page" IsVisible="False">
                <StackPanel Margin="30,26,30,30">
                    <Border Classes="pageHead"><Panel>
                        <PathIcon Classes="headMark" Data="{StaticResource IconMusic}"/>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="headIcon"><PathIcon Data="{StaticResource IconMusic}"/></Border>
                            <StackPanel Grid.Column="1" Classes="headText">
                                <TextBlock Classes="kicker" Text="SPOTIFY"/>
                                <TextBlock Text="Music" Classes="pageTitle"/>
                                <TextBlock Classes="muted" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="Your Spotify, right here while you game. It plays in the Spotify app, so it keeps going when Trophyline is closed."/>
                            </StackPanel>
                        </Grid>
                    </Panel></Border>

                    <!-- ===== now playing: big cover, blurred and colour-matched background, moving equalizer ===== -->
                    <Border x:Name="Hero" CornerRadius="20" ClipToBounds="True" Margin="0,18,0,0" Height="268"
                            Background="{StaticResource Card}" BoxShadow="0 12 40 0 #66000000">
                        <Panel>
                            <Image x:Name="HeroBg" Stretch="UniformToFill" Opacity="0.55" Margin="-60">
                                <Image.Effect><BlurEffect Radius="60"/></Image.Effect>
                            </Image>
                            <Border x:Name="HeroTint">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#B31DB954" Offset="0"/>
                                        <GradientStop Color="#F20B1016" Offset="0.85"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid ColumnDefinitions="Auto,*" Margin="26">
                                <!-- the cover -->
                                <Border Width="196" Height="196" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Center"
                                        Background="#33FFFFFF" BoxShadow="0 14 34 0 #99000000">
                                    <Panel>
                                        <PathIcon x:Name="HeroArtFallback" Data="{StaticResource IconMusic}" Width="64" Height="64" Foreground="#CCFFFFFF"/>
                                        <Image x:Name="HeroArt" Stretch="UniformToFill"/>
                                    </Panel>
                                </Border>
                                <DockPanel Grid.Column="1" Margin="28,4,0,4">
                                    <!-- controls -->
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="14" Margin="0,18,0,0">
                                        <Button x:Name="BigOpen" Classes="accent" Click="OpenSpotify_Click" Content="Open Spotify" IsVisible="False"/>
                                        <StackPanel x:Name="BigButtons" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                            <Button Classes="icon" Click="Prev_Click" ToolTip.Tip="Previous" Width="44" Height="44">
                                                <PathIcon Data="{StaticResource IconPrev}" Width="20" Height="20"/>
                                            </Button>
                                            <Button Classes="icon big" Click="PlayPause_Click" ToolTip.Tip="Play / pause" Width="60" Height="60">
                                                <PathIcon x:Name="BigPlayIcon" Data="{StaticResource IconPlay}" Width="26" Height="26"/>
                                            </Button>
                                            <Button Classes="icon" Click="Next_Click" ToolTip.Tip="Next" Width="44" Height="44">
                                                <PathIcon Data="{StaticResource IconNext}" Width="20" Height="20"/>
                                            </Button>
                                        </StackPanel>
                                        <Button x:Name="SpotifyWindowButton" Classes="pill" Click="ToggleSpotifyWindow_Click" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock x:Name="SpotifyWindowButtonText" Text="Show Spotify"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <!-- equalizer: moves while music plays -->
                                            <StackPanel x:Name="EqBars" Orientation="Horizontal" Spacing="3" Height="18" VerticalAlignment="Bottom">
                                                <Border Classes="eq eq1" Width="4" CornerRadius="2" VerticalAlignment="Bottom" Background="{StaticResource SpotifyGreen}"/>
                                                <Border Classes="eq eq2" Width="4" CornerRadius="2" VerticalAlignment="Bottom" Background="{StaticResource SpotifyGreen}"/>
                                                <Border Classes="eq eq3" Width="4" CornerRadius="2" VerticalAlignment="Bottom" Background="{StaticResource SpotifyGreen}"/>
                                                <Border Classes="eq eq4" Width="4" CornerRadius="2" VerticalAlignment="Bottom" Background="{StaticResource SpotifyGreen}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="BigState" Text="NOW PLAYING" Foreground="{StaticResource SpotifyGreen}" FontSize="12"
                                                       FontWeight="Bold" LetterSpacing="1.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="BigTitle" FontSize="34" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="BigArtist" FontSize="17" Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="HeroFrom" FontSize="13" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Panel>
                    </Border>

                    <!-- ===== playlists (left) and up next (right) ===== -->
                    <Grid ColumnDefinitions="*,24,340" Margin="0,26,0,0">
                        <StackPanel>
                            <TextBlock Text="Your playlists" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Classes="muted" FontSize="12" Margin="0,2,0,12" Text="Click one to play it. Games can have their own soundtrack too (open a game → Soundtrack)."/>
                            <Grid ColumnDefinitions="*,10,Auto">
                                <TextBox x:Name="PlaylistLink" Classes="search" Watermark="Paste a Spotify playlist, album or artist link…">
                                    <TextBox.InnerLeftContent>
                                        <PathIcon Data="{StaticResource IconMusic}" Width="15" Height="15" Margin="12,0,2,0" Foreground="{StaticResource Muted}"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <Button Grid.Column="2" Classes="accent" Click="AddPlaylist_Click" Content="Add"/>
                            </Grid>
                            <TextBlock x:Name="AddHint" Classes="muted" FontSize="12" Margin="2,8,0,14" TextWrapping="Wrap"
                                       Text="In Spotify: right-click a playlist → Share → Copy link to playlist, then paste it here."/>
                            <ItemsControl x:Name="PlaylistGrid" ItemTemplate="{StaticResource PlaylistCard}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="MusicEmpty" Classes="muted" IsVisible="False" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="No playlists yet. Add one above and it stays here for next time."/>
                        </StackPanel>

                        <!-- Spotify's queue, read without showing Spotify (Windows) -->
                        <Border x:Name="QueueCard" Grid.Column="2" Classes="card" Padding="18,16" VerticalAlignment="Top">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Up next" FontWeight="Bold" FontSize="18"/>
                                        <TextBlock x:Name="QueueSub" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="QueueRefreshButton" Grid.Column="1" Classes="pill" Click="QueueRefresh_Click" VerticalAlignment="Center">
                                        <TextBlock x:Name="QueueRefreshText" Text="Refresh"/>
                                    </Button>
                                </Grid>
                                <StackPanel x:Name="QueueList" Spacing="2"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== how Spotify runs ===== -->
                    <Border x:Name="SpotifyWindowRow" Classes="card" Padding="16,12" Margin="0,24,0,0">
                        <StackPanel>
                            <ToggleSwitch x:Name="HideSpotifySwitch" OnContent="" OffContent="" Padding="0" MinWidth="0"
                                          Content="Run Spotify hidden in the background"/>
                            <TextBlock Classes="muted" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="No Spotify window or taskbar button: it just plays. Control it from here or with your keyboard's media keys."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Level & XP -->
            <ScrollViewer x:Name="LevelPage" Classes="page" IsVisible="False">
                <StackPanel Margin="30,26,30,30">
                    <Border Classes="pageHead"><Panel>
                        <PathIcon Classes="headMark" Data="{StaticResource IconShield}"/>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="headIcon"><PathIcon Data="{StaticResource IconShield}"/></Border>
                            <StackPanel Grid.Column="1" Classes="headText">
                                <TextBlock Classes="kicker" Text="LEVEL &amp; XP"/>
                                <TextBlock Text="Level" Classes="pageTitle"/>
                                <TextBlock Classes="muted" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="Everything you do earns XP: unlocking achievements (rare ones give more), finishing games and playing. It counts your whole Steam history."/>
                            </StackPanel>
                        </Grid>
                    </Panel></Border>

                    <Border Classes="card" Padding="26,22" Margin="0,18,0,0" BorderBrush="#55F5C451" BoxShadow="0 10 40 0 #33F5C451">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#2A2617" Offset="0"/>
                                <GradientStop Color="#151C25" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="Auto,*">
                            <Panel Width="132" Height="132">
                                <Ellipse x:Name="BigRing" StrokeThickness="6" Stroke="{StaticResource Gold}"/>
                                <Ellipse Margin="12" Fill="{StaticResource CardHi}"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="LEVEL" FontSize="11" FontWeight="Bold" Classes="muted" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="BigLevel" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                                </StackPanel>
                            </Panel>
                            <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="RankTitle" FontSize="30" FontWeight="Bold"/>
                                <TextBlock x:Name="TotalXp" Classes="muted" FontSize="14" Margin="0,2,0,14"/>
                                <ProgressBar x:Name="BigXpBar" Height="12" MinHeight="12" CornerRadius="6" Minimum="0" Maximum="1"
                                             Background="{StaticResource Line}" Foreground="{DynamicResource AccentGradient}">
                                    <ProgressBar.Transitions>
                                        <Transitions><DoubleTransition Property="Value" Duration="0:0:0.8" Easing="CubicEaseOut"/></Transitions>
                                    </ProgressBar.Transitions>
                                </ProgressBar>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock x:Name="NextRankText" DockPanel.Dock="Right" Classes="muted" FontSize="13"/>
                                    <TextBlock x:Name="XpToNext" FontSize="13" FontWeight="SemiBold"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Where your XP comes from" Classes="section" Margin="0,24,0,4"/>
                    <UniformGrid x:Name="XpTiles" Columns="5" Margin="-8,0,-8,0"/>

                    <TextBlock Text="Ranks" Classes="section" Margin="0,22,0,12"/>
                    <WrapPanel x:Name="RankRoad"/>

                    <Grid ColumnDefinitions="*,24,*" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="How to earn XP" Classes="section" Margin="0,0,0,12"/>
                            <Border Classes="card" Padding="6,4">
                                <ItemsControl x:Name="RulesList"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Recent XP" Classes="section" Margin="0,0,0,12"/>
                            <Border Classes="card" Padding="6,4">
                                <ItemsControl x:Name="RecentXpList"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Leaderboards (online) -->
            <ScrollViewer x:Name="LeaderboardPage" Classes="page" IsVisible="False">
                <StackPanel Margin="30,26,30,30">
                    <Border Classes="pageHead"><Panel>
                        <PathIcon Classes="headMark" Data="{StaticResource IconPodium}" Margin="0,-70,110,-70"/>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="headIcon"><PathIcon Data="{StaticResource IconPodium}"/></Border>
                            <StackPanel Grid.Column="1" Classes="headText">
                                <TextBlock Classes="kicker" Text="ONLINE"/>
                                <TextBlock Text="Leaderboards" Classes="pageTitle"/>
                                <TextBlock x:Name="LbSub" Classes="muted" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="LbRefresh" Grid.Column="2" Classes="pill" Click="LbRefresh_Click" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="Refresh"/>
                            </Button>
                        </Grid>
                    </Panel></Border>

                    <!-- current season -->
                    <Border Classes="card" Padding="22,18" Margin="0,18,0,0" ClipToBounds="True" BorderBrush="#40B98CFF" BoxShadow="0 10 40 0 #2EB98CFF">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#241D3A" Offset="0"/>
                                <GradientStop Color="#151C25" Offset="0.65"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock x:Name="SeasonKicker" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                <TextBlock x:Name="SeasonTitle" FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                                <TextBlock x:Name="SeasonSub" Classes="muted" FontSize="13" Margin="0,2,0,12" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="SeasonBar" Classes="thin" Background="{StaticResource Line}" Foreground="{DynamicResource AccentGradient}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="30,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="YOUR SEASON XP" FontSize="11" FontWeight="Bold" Classes="muted" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="MySeasonXp" FontSize="34" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="MySeasonPlace" Classes="muted" FontSize="13" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- join -->
                    <Border x:Name="JoinCard" Classes="card" Padding="18,14" Margin="0,12,0,0" BorderBrush="{DynamicResource Accent}">
                        <Grid ColumnDefinitions="*,12,220,12,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Join the leaderboards" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="JoinHint" Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="Log in with your Steam account (no extra password). Only Steam-verified players are ranked. Shared: your name, level, XP, game counts, icon, top games and latest unlocks."/>
                            </StackPanel>
                            <TextBox x:Name="JoinName" Grid.Column="2" IsVisible="False"/>
                            <Button Grid.Column="4" Classes="primary" Click="Join_Click" Content="Log in with Steam"/>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,20,0,10">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="BoardSeason" Classes="chip" GroupName="board" Content="Season XP" IsChecked="True"/>
                            <RadioButton x:Name="BoardXp" Classes="chip" GroupName="board" Content="Highest XP"/>
                            <RadioButton x:Name="BoardPerfect" Classes="chip" GroupName="board" Content="Most completed games"/>
                            <RadioButton x:Name="BoardOver75" Classes="chip" GroupName="board" Content="Most games over 75%"/>
                        </StackPanel>
                        <ComboBox x:Name="SeasonPick" Grid.Column="1" Classes="drop" MinWidth="220"/>
                    </Grid>
                    <StackPanel x:Name="LbRows" Spacing="6"/>
                    <TextBlock x:Name="LbEmpty" Classes="muted" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="False"/>

                    <TextBlock Text="Season champions" Classes="section" Margin="0,26,0,12"/>
                    <WrapPanel x:Name="SeasonHistory"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Chat -->
            <Grid x:Name="ChatPage" Classes="page" IsVisible="False" ColumnDefinitions="260,*" Margin="30,26,30,24" RowDefinitions="Auto,*">
                <Border Grid.ColumnSpan="2" Classes="pageHead" Margin="0,0,0,16"><Panel>
                    <PathIcon Classes="headMark" Data="{StaticResource IconChat}"/>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="headIcon"><PathIcon Data="{StaticResource IconChat}"/></Border>
                        <StackPanel Grid.Column="1" Classes="headText">
                            <TextBlock Classes="kicker" Text="TALK TO PLAYERS"/>
                            <TextBlock Text="Chat" Classes="pageTitle"/>
                            <TextBlock x:Name="ChatSub" Classes="muted" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Talk to everyone in the lobby, or message a player privately (open their profile → Message). Messages disappear after 1 hour."/>
                        </StackPanel>
                    </Grid>
                </Panel></Border>

                <!-- conversations -->
                <Border Grid.Row="1" Classes="card" Padding="8" Margin="0,0,16,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ChatRooms" Spacing="4"/>
                    </ScrollViewer>
                </Border>

                <!-- messages -->
                <Border Grid.Row="1" Grid.Column="1" Classes="card" Padding="0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <DockPanel Margin="18,12" LastChildFill="True">
                            <Button x:Name="ChatBlockButton" DockPanel.Dock="Right" Classes="pill" Click="ChatBlock_Click" IsVisible="False">
                                <TextBlock x:Name="ChatBlockText" Text="Block"/>
                            </Button>
                            <Button x:Name="ChatProfileButton" DockPanel.Dock="Right" Classes="pill" Click="ChatProfile_Click" IsVisible="False" Margin="0,0,8,0">
                                <TextBlock Text="Profile"/>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ChatTitle" Text="Lobby" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ChatTitleSub" Classes="muted" FontSize="12"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1">
                            <ScrollViewer x:Name="ChatScroll" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ChatMessages" Margin="18,12" Spacing="10"/>
                            </ScrollViewer>
                        </Border>
                        <Grid Grid.Row="2" ColumnDefinitions="*,10,Auto" Margin="14,12">
                            <TextBox x:Name="ChatInput" Classes="search" Watermark="Write a message…" MaxLength="500" AcceptsReturn="False"/>
                            <Button Grid.Column="2" Classes="primary" Click="ChatSend_Click" MinWidth="0" Padding="0">
                                <PathIcon Data="{StaticResource IconSend}" Width="18" Height="18"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Someone's profile -->
            <ScrollViewer x:Name="PlayerPage" Classes="page" IsVisible="False">
                <StackPanel Margin="30,22,30,30">
                    <Button Classes="pill" Click="PlayerBack_Click" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconBack}" Width="14" Height="14"/>
                            <TextBlock Text="Leaderboards"/>
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="PlayerBody" Margin="0,18,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Shop -->
            <ScrollViewer x:Name="ShopPage" Classes="page" IsVisible="False">
                <StackPanel Margin="30,26,30,30">
                    <Border Classes="pageHead"><Panel>
                        <PathIcon Classes="headMark" Data="{StaticResource IconCart}"/>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="headIcon"><PathIcon Data="{StaticResource IconCart}"/></Border>
                            <StackPanel Grid.Column="1" Classes="headText">
                                <TextBlock Classes="kicker" Text="SPEND YOUR COINS"/>
                                <TextBlock Text="Shop" Classes="pageTitle"/>
                                <TextBlock Classes="muted" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="Every level you reach gives you coins. Spend them on profile icons: they show on your profile, in the sidebar and on the online leaderboards."/>
                            </StackPanel>
                        </Grid>
                    </Panel></Border>
                    <Border Classes="card" Padding="22,18" Margin="0,18,0,0" BorderBrush="#55F5C451" BoxShadow="0 10 40 0 #33F5C451">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#2A2617" Offset="0"/>
                                <GradientStop Color="#151C25" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#33F5C451">
                                <PathIcon Data="{StaticResource IconCoin}" Width="34" Height="34" Foreground="{StaticResource Gold}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CoinBalance" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Gold}"/>
                                <TextBlock x:Name="CoinSub" Classes="muted" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="EQUIPPED" FontSize="11" FontWeight="Bold" Classes="muted" HorizontalAlignment="Center"/>
                                <Panel x:Name="EquippedPreview" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ShopMessage" Margin="2,12,0,0" FontWeight="SemiBold" IsVisible="False"/>
                    <StackPanel x:Name="ShopTiers" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Playtime (sessions recorded by the tracker) -->
            <ScrollViewer x:Name="PlaytimePage" Classes="page" IsVisible="False">
                <StackPanel Margin="30,26,30,30">
                    <Border Classes="pageHead"><Panel>
                        <PathIcon Classes="headMark" Data="{StaticResource IconClock}"/>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="headIcon"><PathIcon Data="{StaticResource IconClock}"/></Border>
                            <StackPanel Grid.Column="1" Classes="headText">
                                <TextBlock Classes="kicker" Text="TIME PLAYED"/>
                                <TextBlock Text="Playtime" Classes="pageTitle"/>
                                <TextBlock x:Name="PlaytimeSub" Classes="muted" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Panel></Border>

                    <Border x:Name="NowPlayingCard" Classes="card" Margin="0,18,0,0" Padding="0" ClipToBounds="True" IsVisible="False"
                            BorderBrush="{DynamicResource Accent}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Image x:Name="NowPlayingImage" Width="220" Height="103" Stretch="UniformToFill"/>
                            <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                                    <TextBlock Text="PLAYING NOW" Foreground="{StaticResource Green}" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock x:Name="NowPlayingName" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="NowPlayingSub" Classes="muted" FontSize="14"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid x:Name="PlaytimeTiles" Columns="4" Margin="-8,10,-8,0"/>

                    <Border Classes="card" Padding="20,18" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="ChartTotal" DockPanel.Dock="Right" Classes="muted" VerticalAlignment="Center"/>
                                <TextBlock Text="Last 14 days" Classes="section"/>
                            </DockPanel>
                            <Canvas x:Name="PlayChart" Height="190" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Recent sessions" Classes="section" Margin="0,24,0,12"/>
                    <ItemsControl x:Name="SessionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="local:SessionVM">
                                <Button Classes="plain" Click="OpenSessionGame_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Border Classes="card row" CornerRadius="12" Padding="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="120" Height="56" CornerRadius="8" Background="{StaticResource CardHi}" ClipToBounds="True">
                                                <Image Source="{Binding Header}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding When}" Classes="muted" FontSize="13" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="18" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" MinWidth="90" TextAlignment="Right" Margin="0,0,8,0"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="SessionsEmpty" Classes="muted" TextWrapping="Wrap" IsVisible="False"
                               Text="No sessions yet. Start a game in Steam: the background tracker writes down when you start and stop playing, and it shows up here."/>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsPage" Classes="page" IsVisible="False">
                <StackPanel Margin="30,26,30,30" MaxWidth="900" HorizontalAlignment="Left">
                    <Border Classes="pageHead"><Panel>
                        <PathIcon Classes="headMark" Data="{StaticResource IconSettings}"/>
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="headIcon"><PathIcon Data="{StaticResource IconSettings}"/></Border>
                            <StackPanel Grid.Column="1" Classes="headText">
                                <TextBlock Classes="kicker" Text="MAKE IT YOURS"/>
                                <TextBlock Text="Settings" Classes="pageTitle"/>
                                <TextBlock Classes="muted" Margin="0,2,0,0" Text="Saved straight away."/>
                            </StackPanel>
                        </Grid>
                    </Panel></Border>

                    <TextBlock Text="Achievements on this PC" Classes="section" Margin="0,26,0,4"/>
                    <TextBlock Classes="muted" FontSize="13" Margin="0,0,0,14" TextWrapping="Wrap"
                               Text="Whose achievements Trophyline shows, read from Steam's files on this computer. When you log in with Steam (below), it shows that account."/>
                    <Border Classes="card" Padding="16,14">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="AccountNow" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="Auto,12,*">
                                <TextBlock Text="Show" VerticalAlignment="Center" MinWidth="80"/>
                                <ComboBox x:Name="AccountPick" Grid.Column="2" Classes="drop" MaxWidth="460" HorizontalAlignment="Left" MinWidth="360"/>
                            </Grid>
                            <TextBlock x:Name="AccountStatus" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Accent colour" Classes="section" Margin="0,26,0,4"/>
                    <TextBlock Classes="muted" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap"
                               Text="Colours the menu, buttons, progress bars and the activity calendar."/>
                    <WrapPanel x:Name="AccentPicker"/>

                    <TextBlock Text="Achievement pop-ups" Classes="section" Margin="0,20,0,4"/>
                    <TextBlock Classes="muted" FontSize="13" Margin="0,0,0,14" TextWrapping="Wrap"
                               Text="A card slides in at the bottom-right corner when you unlock an achievement, with its icon and how rare it is. It never takes focus away from your game. (Games in exclusive fullscreen mode draw over it; borderless / windowed fullscreen shows it.)"/>
                    <Border Classes="card" Padding="16,12" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <ToggleSwitch x:Name="PopupsSwitch" OnContent="" OffContent="" Padding="0" MinWidth="0"
                                          Content="Show a pop-up when I unlock an achievement"/>
                            <Button Grid.Column="1" Classes="pill" Click="TestPopup_Click" VerticalAlignment="Center">
                                <TextBlock Text="Show a test pop-up"/>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="Steam account" Classes="section" Margin="0,20,0,4"/>
                    <TextBlock Classes="muted" FontSize="13" Margin="0,0,0,14" TextWrapping="Wrap"
                               Text="Log in with your Steam account: no extra account or password, on any computer. It puts you in the chat and, once Steam has confirmed your achievements, on the leaderboards. Your name is your Steam name; your level, XP and games come from Steam itself. The app only sends your equipped icon, profile links and the chat messages you write. Never your Steam password."/>
                    <Border Classes="card" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel Spacing="10">
                            <ToggleSwitch x:Name="OnlineSwitch" IsVisible="False"/>

                            <!-- not logged in (or an old profile that still needs to log in with Steam) -->
                            <StackPanel x:Name="LoggedOutPanel" Spacing="10">
                                <TextBlock x:Name="AccountIntro" FontWeight="SemiBold" TextWrapping="Wrap" Text="Log in with your Steam account"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="SteamLoginButton" Classes="primary" Click="SteamLogin_Click" MinHeight="0" Padding="0">
                                        <TextBlock Text="Log in with Steam" Margin="0,9"/>
                                    </Button>
                                    <Button x:Name="CodeLoginButton" Classes="pill" Click="CodeLogin_Click" VerticalAlignment="Center">
                                        <TextBlock Text="Steam's page blocked? Use a name code"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="Log in with Steam opens Steam's own login page in your browser; Trophyline never sees your Steam password. If that page doesn't load (some school and work networks block it), use a name code instead."/>
                                <!-- name code: put a short code in your Steam profile name for a minute -->
                                <Border x:Name="CodePanel" IsVisible="False" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="CodeAccount" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock x:Name="CodeText" FontSize="28" FontWeight="Bold" FontFamily="Consolas, Menlo, monospace" VerticalAlignment="Center"/>
                                            <Button Classes="pill" Click="CopyCode_Click" VerticalAlignment="Center"><TextBlock x:Name="CopyCodeText" Text="Copy"/></Button>
                                        </StackPanel>
                                        <TextBlock FontSize="13" TextWrapping="Wrap"
                                                   Text="1. In Steam, open Friends &amp; Chat, click the arrow next to your name and choose Change Profile Name.&#10;2. Add this code to your profile name (for example: yourname TL1A2B3) and save.&#10;3. Press Check. Once you're in, you can change your name back."/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button x:Name="CodeCheckButton" Classes="primary" Click="CodeCheck_Click" MinHeight="0" Padding="0">
                                                <TextBlock Text="Check" Margin="0,9"/>
                                            </Button>
                                            <Button Classes="pill" Click="CodeCancel_Click" VerticalAlignment="Center"><TextBlock Text="Cancel"/></Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- logged in -->
                            <StackPanel x:Name="LoggedInPanel" Spacing="10" IsVisible="False">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="LoggedInAs" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Classes="pill" Click="Logout_Click"><TextBlock Text="Log out"/></Button>
                                </Grid>

                                <!-- Steam-verified scores -->
                                <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="14,12" Margin="0,6,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="VerifyTitle" FontWeight="SemiBold" TextWrapping="Wrap" Text="Steam-verified scores"/>
                                        <TextBlock x:Name="VerifyText" FontSize="13" TextWrapping="Wrap" Text="Loading…"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button x:Name="VerifyButton" Classes="pill" Click="VerifyNow_Click" VerticalAlignment="Center">
                                                <TextBlock Text="Check now"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="VerifyMsg" FontSize="12" TextWrapping="Wrap" IsVisible="False"/>
                                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                                   Text="Steam only shares your achievements if your game details are public: in Steam, open your profile → Edit Profile → Privacy Settings → Game details: Public."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="AccountMsg" FontSize="12" TextWrapping="Wrap" Foreground="#FFB86B" IsVisible="False"/>

                            <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                       Text="Your name on Trophyline is your Steam profile name. To change it, change it in Steam (Friends &amp; Chat → arrow next to your name → Change Profile Name); Trophyline picks it up at the next Steam check."/>
                            <TextBlock x:Name="OnlineStatus" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="Profile picture" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Panel x:Name="MyPicturePreview" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center" Spacing="8">
                                    <TextBlock x:Name="PictureStatus" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="460"
                                               Text="Your picture is your Steam profile picture."/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Profile links" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                       Text="Optional. Anyone who opens your profile sees these and can click them. Type just your username (or paste your profile link). Leave empty to hide."/>
                            <WrapPanel x:Name="LinkBoxes"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Classes="pill" Click="SaveLinks_Click"><TextBlock Text="Save links"/></Button>
                                <TextBlock x:Name="LinksStatus" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Updates" Classes="section" Margin="0,20,0,4"/>
                    <Border Classes="card" Padding="16,12" Margin="0,10,0,10">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <ToggleSwitch x:Name="AutoUpdateSwitch" OnContent="" OffContent="" Padding="0" MinWidth="0"
                                              Content="Ask about new versions when I open Trophyline"/>
                                <Button Grid.Column="1" Classes="pill" Click="CheckUpdates_Click" VerticalAlignment="Center">
                                    <TextBlock Text="Check now"/>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="UpdateStatus" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Game soundtracks" Classes="section" Margin="0,20,0,4"/>
                    <TextBlock Classes="muted" FontSize="13" Margin="0,0,0,14" TextWrapping="Wrap"
                               Text="Give a game a playlist on its page (Games → pick a game → Soundtrack). The background tracker starts it when you launch the game, even when this window is closed."/>
                    <Border Classes="card" Padding="16,12">
                        <StackPanel>
                            <ToggleSwitch x:Name="PauseOnQuitSwitch" OnContent="" OffContent="" Padding="0" MinWidth="0"
                                          Content="Pause the music when I quit the game"/>
                            <TextBlock x:Name="SoundtrackCount" Classes="muted" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Delete account" Classes="section" Margin="0,26,0,4" Foreground="#FF6B6B"/>
                    <Border Classes="card" Padding="16,12" BorderBrush="#66FF6B6B">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Delete my online account" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DeleteAccountHint" Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="Removes your profile, scores, season history, profile picture and every chat message you wrote from the server, for good. Your Steam data, levels and shop items on this computer stay."/>
                            </StackPanel>
                            <Button x:Name="DeleteAccountButton" Grid.Column="1" Click="DeleteAccount_Click" VerticalAlignment="Center" Cursor="Hand"
                                    Background="#33FF6B6B" Foreground="#FF8A8A" BorderBrush="#FF6B6B" BorderThickness="1" CornerRadius="10" Padding="16,9">
                                <TextBlock x:Name="DeleteAccountText" Text="Delete account" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- first-start notice about automatic updates (shown once to everyone) -->
            <Border x:Name="WelcomeOverlay" IsVisible="False" Background="#E60B1016">
                <Border Classes="card" MaxWidth="580" Padding="30,26" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                        BorderBrush="{StaticResource Gold}" BoxShadow="0 12 40 0 #A0000000">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconDownload}" Width="28" Height="28" Foreground="{StaticResource Gold}"/>
                            <TextBlock Text="New versions, when you want them" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="When you open Trophyline and a new version is out, it asks whether you want to update. Say yes and it downloads the new version from its GitHub page, installs it and restarts by itself."/>
                        <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
                                   Text="&#8226; Nothing is installed without asking you.&#10;&#8226; Every download is checked against the release's fingerprint before it's installed.&#10;&#8226; Say &quot;Later&quot; and it asks again the next time you open Trophyline.&#10;&#8226; On macOS it opens the download page instead."/>
                        <CheckBox x:Name="WelcomeAutoUpdate" IsChecked="True" Margin="0,4,0,0"
                                  Content="Ask me about new versions (you can change this any time in Settings)"/>
                        <Button Classes="primary" Click="AcceptWelcome_Click" HorizontalAlignment="Right" Margin="0,6,0,0" Content="Got it"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- "A new version is out: update now?" asked when the window opens -->
            <Border x:Name="UpdatePrompt" IsVisible="False" Background="#E60B1016">
                <Border Classes="card" MaxWidth="520" Padding="30,26" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                        BorderBrush="{DynamicResource Accent}" BoxShadow="0 12 40 0 #A0000000">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconDownload}" Width="28" Height="28" Foreground="{DynamicResource Accent}"/>
                            <TextBlock x:Name="UpdatePromptTitle" Text="A new version is out" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="UpdatePromptText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="UpdatePromptMsg" Classes="muted" FontSize="13" TextWrapping="Wrap"
                                   Text="It takes a few seconds. Trophyline restarts by itself; your achievements and settings stay."/>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button x:Name="UpdateLaterButton" Classes="pill" Click="UpdateLater_Click" VerticalAlignment="Center">
                                <TextBlock Text="Later"/>
                            </Button>
                            <Button x:Name="UpdateNowButton" Classes="primary" Click="UpdateNow_Click" MinHeight="0" Padding="0">
                                <TextBlock x:Name="UpdateNowText" Text="Update now" Margin="0,9"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- "Updated" banner -->
            <Border x:Name="UpdateBanner" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                    CornerRadius="14" Padding="18,12" Background="#F2151C25" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                    BoxShadow="0 8 30 0 #90000000">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Classes="primary" Click="RestartForUpdate_Click" MinHeight="0" Padding="0">
                        <TextBlock Text="Restart now" Margin="0,8"/>
                    </Button>
                    <Button Classes="pill" Click="HideUpdateBanner_Click" VerticalAlignment="Center"><TextBlock Text="Later"/></Button>
                </StackPanel>
            </Border>

            <!-- "Level up!" banner -->
            <Border x:Name="LevelUpBanner" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0"
                    CornerRadius="16" Padding="22,14" Background="#F2151C25" BorderBrush="{StaticResource Gold}" BorderThickness="1"
                    BoxShadow="0 8 30 0 #90000000">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <PathIcon Data="{StaticResource IconShield}" Width="30" Height="30" Foreground="{StaticResource Gold}"/>
                    <StackPanel>
                        <TextBlock Text="LEVEL UP!" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Gold}"/>
                        <TextBlock x:Name="LevelUpText" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- loading / problem overlay -->
            <Border x:Name="Overlay" Background="{StaticResource Bg}" IsVisible="False">
                <TextBlock x:Name="OverlayText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Classes="muted" FontSize="15" TextWrapping="Wrap" MaxWidth="560"/>
            </Border>
        </Panel>
    </Grid>
</Window>
