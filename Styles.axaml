<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- cards: a faint top-lit gradient, a hairline highlight and a soft shadow -->
    <Style Selector="Border.card">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#19212C" Offset="0"/>
                <GradientStop Color="#141A22" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush" Value="#263244"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BoxShadow" Value="0 8 24 0 #40000000"/>
    </Style>

    <!-- page header banner: icon badge, title, subtitle and a big faint icon on the right -->
    <Style Selector="Border.pageHead">
        <Setter Property="Background" Value="{DynamicResource AccentHead}"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="24,20"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="BoxShadow" Value="0 12 36 0 #55000000"/>
    </Style>
    <Style Selector="Border.headIcon">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource AccentAvatar}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AccentGlow}"/>
    </Style>
    <Style Selector="Border.headIcon > PathIcon">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Foreground" Value="#0B1016"/>
    </Style>
    <Style Selector="PathIcon.headMark">
        <Setter Property="Width" Value="190"/>
        <Setter Property="Height" Value="190"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,-70,-20,-70"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Opacity" Value="0.09"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="RenderTransform" Value="rotate(-12deg)"/>
    </Style>
    <Style Selector="StackPanel.headText">
        <Setter Property="Margin" Value="18,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.kicker">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="1.6"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- pages fade in when you switch to them -->
    <Style Selector=":is(Control).page[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style Selector="TextBlock.groupHeader">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Margin" Value="2,16,0,10"/>
    </Style>

    <!-- sidebar navigation (Tag = icon geometry) -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Margin" Value="12,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bd" Background="Transparent" CornerRadius="10" Padding="14,11">
                    <Panel>
                        <Border Name="bar" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource Accent}"
                                HorizontalAlignment="Left" Margin="-14,0,0,0" IsVisible="False"/>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Name="ico" Data="{TemplateBinding Tag}" Width="17" Height="17"/>
                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="#141C26"/>
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#bd">
        <Setter Property="Background" Value="{DynamicResource AccentNav}"/>
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#bar">
        <Setter Property="BoxShadow" Value="{DynamicResource AccentGlow}"/>
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#bar">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ PathIcon#ico">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- filter chips -->
    <Style Selector="RadioButton.chip">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bd" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="16" Padding="14,6">
                    <ContentPresenter Content="{TemplateBinding Content}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.chip:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="RadioButton.chip:checked">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="RadioButton.chip:checked /template/ Border#bd">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- a button that only shows its content -->
    <Style Selector="Button.plain">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter" Background="Transparent"
                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- game cards lift and glow on hover -->
    <Style Selector="Button.plain Panel.art">
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.plain:pointerover Panel.art">
        <Setter Property="RenderTransform" Value="translateY(-5px)"/>
    </Style>
    <Style Selector="Button.plain:pointerover Border.artFrame">
        <Setter Property="BoxShadow" Value="{DynamicResource AccentGlow}"/>
    </Style>
    <Style Selector="Button.plain Border.row">
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.plain:pointerover Border.row">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AccentGlow}"/>
        <Setter Property="RenderTransform" Value="translateX(4px)"/>
    </Style>
    <!-- achievement rows light up a little on hover -->
    <Style Selector="ListBoxItem:pointerover Border.card">
        <Setter Property="BorderBrush" Value="#3A4A60"/>
        <Setter Property="Background" Value="{StaticResource CardHi}"/>
    </Style>

    <Style Selector="Button.pill">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bd" Background="#AA0B1016" CornerRadius="18" Padding="14,7" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <ContentPresenter Content="{TemplateBinding Content}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.pill:pointerover /template/ Border#bd">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- lyrics lines: the one being sung lights up, the rest wait dimmed -->
    <Style Selector="TextBlock.lyr">
        <Setter Property="FontSize" Value="23"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Padding" Value="0,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0%,50%"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBlock.lyr.past"><Setter Property="Opacity" Value="0.22"/></Style>
    <Style Selector="TextBlock.lyr:pointerover"><Setter Property="Opacity" Value="0.7"/></Style>
    <Style Selector="TextBlock.lyr.now">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="RenderTransform" Value="scale(1.06)"/>
    </Style>
    <Style Selector="TextBlock.lyr.plain">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="Padding" Value="0,2"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- round icon buttons (music controls) -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bd" Background="Transparent" CornerRadius="17">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="#22FFFFFF"/>
    </Style>
    <Style Selector="Button.icon.big">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Foreground" Value="#0B1016"/>
    </Style>
    <Style Selector="Button.icon.big /template/ Border#bd">
        <Setter Property="Background" Value="{StaticResource SpotifyGreen}"/>
        <Setter Property="CornerRadius" Value="21"/>
    </Style>
    <Style Selector="Button.icon.big:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="#3BE477"/>
    </Style>

    <Style Selector="Button.accent">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#0B1016"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bd" Background="{StaticResource SpotifyGreen}" CornerRadius="10" Padding="20,0" MinHeight="42">
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="#3BE477"/>
    </Style>

    <!-- the big Play button on a game page (uses the accent colour) -->
    <Style Selector="Button.primary">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#0B1016"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bd" Background="{DynamicResource AccentGradient}" CornerRadius="12" Padding="26,0" MinHeight="48"
                        BoxShadow="{DynamicResource AccentGlow}">
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
    </Style>

    <!-- accent colour swatches in Settings -->
    <Style Selector="RadioButton.swatch">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,14,14"/>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="8" Width="84">
                    <Border Name="ring" Width="56" Height="56" CornerRadius="28" BorderThickness="3" BorderBrush="Transparent"
                            HorizontalAlignment="Center" Padding="4">
                        <Border CornerRadius="24" Background="{TemplateBinding Background}">
                            <PathIcon Name="tick" Data="{StaticResource IconCheck}" Width="20" Height="20" Foreground="#0B1016" IsVisible="False"/>
                        </Border>
                    </Border>
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.swatch:pointerover /template/ Border#ring">
        <Setter Property="BorderBrush" Value="#44FFFFFF"/>
    </Style>
    <Style Selector="RadioButton.swatch:checked /template/ Border#ring">
        <Setter Property="BorderBrush" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="RadioButton.swatch:checked /template/ PathIcon#tick">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- playlist cards: play badge and remove button appear on hover -->
    <Style Selector="Button.plain Border.playBadge">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.plain:pointerover Border.playBadge">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.plain Button.remove">
        <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Button.plain:pointerover Button.remove">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- inputs -->
    <Style Selector="TextBox.search">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,8,12,8"/>
    </Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource CardHi}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="ComboBox.drop">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Padding" Value="12,0,8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox.drop:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource CardHi}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- lists without selection highlight -->
    <Style Selector="ListBox.flat">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="ListBox.flat ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter" Background="Transparent"
                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="Stretch"/>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ProgressBar.thin">
        <Setter Property="MinHeight" Value="5"/>
        <Setter Property="Height" Value="5"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Background" Value="#40FFFFFF"/>
    </Style>

    <!-- Music page: equalizer bars that move while music plays (class "on") -->
    <Style Selector="Border.eq1.on">
        <Style.Animations>
            <Animation Duration="0:0:0.55" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Height" Value="4"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Height" Value="16"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.eq2.on">
        <Style.Animations>
            <Animation Duration="0:0:0.8" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Height" Value="14"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Height" Value="5"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.eq3.on">
        <Style.Animations>
            <Animation Duration="0:0:0.65" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Height" Value="6"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Height" Value="18"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.eq4.on">
        <Style.Animations>
            <Animation Duration="0:0:0.95" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Height" Value="12"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Height" Value="3"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.eq:not(.on)">
        <Setter Property="Height" Value="3"/>
    </Style>
</Styles>