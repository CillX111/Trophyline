<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = no console window on Windows (ignored on Linux and macOS). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Trophyline</AssemblyName>
    <RootNamespace>Trophyline</RootNamespace>
    <Product>Trophyline</Product>
    <Version>1.1.1</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Registry/COM calls are guarded by OperatingSystem.IsWindows() checks. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**;publish\**;dist\**</DefaultItemExcludes>

    <!-- Keep the background tracker small: workstation GC, no extras.
         The window (Avalonia) is only loaded when you open it. -->
    <PublishSingleFile Condition="'$(PublishAot)' != 'true'">true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <TieredPGO>false</TieredPGO>
    <OptimizationPreference>Size</OptimizationPreference>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="assets\**" />
    <!-- also embedded plainly, so the install command can write it out as the Linux menu icon -->
    <EmbeddedResource Include="assets\logo.png" LogicalName="Trophyline.logo.png" />
  </ItemGroup>

</Project>
